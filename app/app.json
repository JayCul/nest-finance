{
  "expo": {
    "name": "Nest Finance",
    "slug": "nest-finance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nestfinance",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0CB0E6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nestfinance.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#12B9EC",
          "dark": {
            "backgroundColor": "#12B9EC"
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Nest Finance shares your location with your emergency contact only when your backup PIN is used."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Nest Finance uses the camera only to scan a guardian code.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#12B9EC"
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    }
  }
}
